# ── Dawakhana — Smart Pharmacy Management System ────────────────
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Server
PORT=5000
NODE_ENV=production

# Security: generate with `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-secret-32-bytes-minimum
JWT_EXPIRES_IN=7d

# Rate limiting (requests per window per IP)
RATE_LIMIT_WINDOW_MS=900000        # 15 minutes
RATE_LIMIT_MAX=200                 # 200 requests / window

# Database file path (relative to project root)
DB_PATH=./data/pharmacy.db
